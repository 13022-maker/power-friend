# 不填任何值 → 自動進入 demo 模式（記憶體假資料，免金鑰即可完整體驗流程）

# 填入後改用 Supabase（先在 SQL Editor 執行 supabase/schema.sql 與 supabase/seed.sql）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 僅伺服器端使用（server actions / MCP 端點）；切勿暴露到前端
SUPABASE_SERVICE_ROLE_KEY=

# Meta Muse Spark（選填）。不填 → AI 功能用本地規則。
# 金鑰在 https://dev.meta.ai 申請；OpenAI 相容格式。
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.1
MUSE_TIMEOUT_MS=8000
# 設為 1 可暫時關閉 Muse（例如額度用完）
MUSE_DISABLED=
